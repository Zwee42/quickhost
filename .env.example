# QuickHost Environment Configuration
# Copy this file to .env and fill in the values

# ======================
# Core Configuration
# ======================

# Root domain for subdomains (e.g., example.com)
ROOT_DOMAIN=example.com

# Base port for container allocation (starts here and increments)
BASE_PORT=5000

# Environment: development or production
NODE_ENV=production

# ======================
# SSL/HTTPS Configuration
# ======================

# Enable HTTPS with Let's Encrypt (true/false)
ENABLE_SSL=true

# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@example.com

# Agree to Let's Encrypt Terms of Service
CERTBOT_AGREE_TOS=true

# ======================
# Paths Configuration
# ======================

# Path for persistent data storage
DATA_PATH=/data/quickhost.db

# Path for project source code
PROJECTS_PATH=/data/projects

# Path for SSL certificates
CERT_PATH=/data/certificates

# Path for NGINX configuration
NGINX_CONF_DIR=/etc/nginx/conf.d

# ======================
# Database Configuration
# ======================

# SQLite is used by default (file-based, no additional config needed)
# For production, consider using PostgreSQL instead

# ======================
# Docker Configuration
# ======================

# Docker network name for container communication
DOCKER_NETWORK=quickhost-network

# ======================
# Security Configuration
# ======================

# API Key for administrative operations (if needed)
# API_KEY=your-secure-key-here

# Enable authentication (future feature)
# AUTH_ENABLED=false

# ======================
# Logging Configuration
# ======================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Maximum log entries to keep per project
MAX_LOGS_PER_PROJECT=1000
